{
  "expo": {
    "name": "ROLT",
    "slug": "rolt_app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.roltapp.rolt",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0022FF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1515FF",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-status-bar",
      "expo-router",
      "expo-font",
      "@rnmapbox/maps",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ROLT, sürüşünü kaydedebilmek ve haritada konumunu gösterebilmek için konumunu kullanır.",
          "locationAlwaysAndWhenInUsePermission": "ROLT, ekran kapalıyken de sürüş kaydedebilmek için konumunu her zaman kullanır.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "locationAlwaysPermission": "ROLT, ekran kapalıyken de sürüş kaydedebilmek için konumunu her zaman kullanır."
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "ROLT, profiline, sürüşlerine ve önerdiğin rotalara fotoğraf ekleyebilmen için seçtiğin fotoğraflara erişir.",
          "cameraPermission": "ROLT, rotalarına ve sürüşlerine fotoğraf ekleyebilmen için kamerayı kullanır.",
          "microphonePermission": false
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "tr",
              "en"
            ],
            "android": [
              "tr",
              "en"
            ]
          }
        }
      ],
      "expo-image",
      [
        "expo-media-library",
        {
          "photosPermission": "ROLT, profiline, sürüşlerine ve önerdiğin rotalara fotoğraf ekleyebilmen için seçtiğin fotoğraflara erişir.",
          "savePhotosPermission": "ROLT, profil kartını fotoğraflarına kaydedebilmen için galeriye görsel ekler.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-sensors",
        {
          "motionPermission": "ROLT, sürüş sırasında yatış açını ölçmek için telefonun hareket sensörlerini kullanır."
        }
      ],
      "expo-widgets"
    ],
    "scheme": "rolt",
    "experiments": {
      "typedRoutes": true
    },
    "locales": {
      "tr": "./src/i18n/native/tr.json",
      "en": "./src/i18n/native/en.json"
    },
    "extra": {
      "eas": {
        "projectId": "33f1ffce-5ef5-459a-ba50-710a0988cba8"
      }
    },
    "owner": "milbas"
  }
}

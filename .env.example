# Copy to .env (git-ignored) and fill in. See docs/mapbox-routing.md.

# Public Mapbox access token (starts with pk.) from https://console.mapbox.com/account/access-tokens/
# One token covers maps, Search Box (address autocomplete) and Directions (route line, distance, duration).
# Leave as "pk." to use the built-in mock search/routing; Expo Go always shows the design's map artwork.
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.

# Optional: custom Mapbox Studio style (mapbox://styles/<user>/<style-id>). Falls back to Mapbox Outdoors.
EXPO_PUBLIC_MAPBOX_STYLE_URL=

# Address search bias: ISO 3166 alpha-2 country list (comma separated). Default: tr
EXPO_PUBLIC_MAPBOX_SEARCH_COUNTRY=tr

# Routing provider for route suggestions: mapbox (default) | valhalla (self-hosted, later)
EXPO_PUBLIC_ROUTING_PROVIDER=mapbox
# Base URL of the self-hosted Valhalla server when EXPO_PUBLIC_ROUTING_PROVIDER=valhalla
EXPO_PUBLIC_VALHALLA_URL=

# Mock backend for route suggestions (until Supabase): success (default) | fail → shows 04.6 "Rota gönderilemedi"
EXPO_PUBLIC_MOCK_SUBMISSION=success

# Dev only: 1 → clear stored session/guest/onboarding state on every launch (start from onboarding).
# Usually set inline instead: EXPO_PUBLIC_RESET_STATE=1 npx expo start --clear
EXPO_PUBLIC_RESET_STATE=

# Optional, build time only: secret token (sk.…) with DOWNLOADS:READ, only if the native build
# fails with a 401 while downloading the Mapbox SDK. Never prefix it with EXPO_PUBLIC_.
RNMAPBOX_MAPS_DOWNLOAD_TOKEN=

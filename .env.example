# Copy to .env.local (git-ignored) and fill in.
# Public Mapbox access token (pk.*) from https://console.mapbox.com/account/access-tokens/
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=
# Optional: custom Mapbox Studio style (mapbox://styles/<user>/<style-id>). Falls back to Mapbox Outdoors.
EXPO_PUBLIC_MAPBOX_STYLE_URL=
